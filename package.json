{
  "name": "physics-sims",
  "version": "1.0.0",
  "description": "Interactive 3D physics simulations for Physics 4B (E&M). Honors contract, RCC Fall 2026.",
  "scripts": {
    "dev": "vite --config apps/01-electrostatics/vite.config.ts",
    "build": "vite build --config apps/01-electrostatics/vite.config.ts && vite build --config apps/02-circuits/vite.config.ts",
    "preview": "vite preview --config apps/01-electrostatics/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:02": "vite --config apps/02-circuits/vite.config.ts",
    "preview:02": "vite preview --config apps/02-circuits/vite.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "motion": "^14.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
